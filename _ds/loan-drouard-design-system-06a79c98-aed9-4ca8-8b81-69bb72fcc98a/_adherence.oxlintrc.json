{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/**",
              "components/actions/**",
              "components/contenu/**",
              "components/icones/**",
              "components/layout/**",
              "components/navigation/**",
              "components/reseaux/**",
              "components/typographie/**",
              "header-flottant.js",
              "ui_kits/site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cinzel|Cormorant|Cormorant SC|Long Cang|Ma Shan Zheng))/i]",
        "message": "Font not provided by the design system. Available: Cinzel, Cormorant, Cormorant SC, Long Cang, Ma Shan Zheng."
      },
      {
        "selector": "JSXOpeningElement[name.name='LienReseau'] > JSXAttribute > JSXIdentifier[name!=/^(?:reseau|href|nom|key|ref|className|style|children)$/]",
        "message": "<LienReseau> doesn't accept that prop. Declared props: reseau, href, nom."
      },
      {
        "selector": "JSXOpeningElement[name.name='Bouton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|ton|taille|coinCoupe|avecSceau|href|onClick|disabled|type|style|className|key|ref|className|style|children)$/]",
        "message": "<Bouton> doesn't accept that prop. Declared props: children, ton, taille, coinCoupe, avecSceau, href, onClick, disabled, type, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Bouton'] > JSXAttribute[name.name='ton'] > Literal[value!=/^(?:sombre|clair)$/]",
        "message": "<Bouton> ton must be one of 'sombre' | 'clair'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Bouton'] > JSXAttribute[name.name='taille'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Bouton> taille must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Bouton'] > JSXAttribute[name.name='coinCoupe'] > Literal[value!=/^(?:bg|bd|hg|hd)$/]",
        "message": "<Bouton> coinCoupe must be one of 'bg' | 'bd' | 'hg' | 'hd'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Bouton'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Bouton> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Annotation'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|accent|pose|inverse|style|className|key|ref|className|style|children)$/]",
        "message": "<Annotation> doesn't accept that prop. Declared props: children, accent, pose, inverse, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChiffresCles'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|ton|style|className|key|ref|className|style|children)$/]",
        "message": "<ChiffresCles> doesn't accept that prop. Declared props: items, ton, style, className."
