// Redirections vers https://loandrouard.com (www et .fr). Aucun fichier servi.
// Déploiement : npm run publier:redirection
{
  "name": "loandrouard-redirection",
  "main": "worker/redirection.js",
  "compatibility_date": "2026-09-01",
  "routes": [
    { "pattern": "www.loandrouard.com", "custom_domain": true },
    { "pattern": "loandrouard.fr", "custom_domain": true },
    { "pattern": "www.loandrouard.fr", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
