// Site public loandrouard.com — Cloudflare Workers Static Assets.
// Sert public/ tel quel (aucune réécriture d'URL). Déploiement : npm run publier
{
  "name": "loandrouard-site",
  "main": "worker/site.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Pas de « pretty URLs » : X.html reste X.html, ?lang= et ?session_id= intacts.
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // Liaison directe avec le Worker API (route /acces/<jeton> de worker/site.js).
  "services": [{ "binding": "API", "service": "loan-api" }],
  // Domaine du site (Custom Domain). L'adresse workers.dev reste disponible pour les prévisualisations.
  "routes": [{ "pattern": "loandrouard.com", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false
}
